         ============================================ -->
    <section class="bg-[var(--color-surface)] py-12 md:py-16">
      <div class="mx-auto max-w-4xl px-6">
        <p class="mx-auto mb-10 max-w-2xl text-balance text-center text-lg leading-relaxed text-[var(--color-text-medium)] md:text-xl">
          <strong class="font-bold text-[var(--color-primary)]">3 mois d'accompagnement</strong> avec un open-coaching en live chaque semaine, un suivi individuel mensuel avec Claire, et 2 stages.
        </p>
        <p class="section-label mb-3 text-center text-[var(--color-accent)]">{t("ei.bonus.label")}</p>
        <div class="divider mx-auto mt-2 mb-8" style="background-color: var(--color-accent);"></div>
        <div class="grid gap-4 md:grid-cols-2">
          {bonuses.map((bonus) => (
            <div class="flex items-start gap-4 rounded-lg border border-l-[3px] border-[var(--color-accent)]/20 border-l-[var(--color-accent)] bg-[var(--color-accent)]/10 p-5 shadow-sm transition-shadow hover:shadow-md">
              <span class="badge-included shrink-0 mt-0.5 !border-[var(--color-accent)] !bg-transparent !text-[var(--color-accent)]">{bonus.badge}</span>
              <p class="text-base leading-relaxed text-[var(--color-text-medium)]">{bonus.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================
         11. TARIF — Session du 15 février au 15 mai 2027
         ============================================ -->
    <section id="tarif" class="bg-[var(--color-warm-dark)] py-16 md:py-24 scroll-mt-20">
      <div class="mx-auto max-w-6xl px-6 text-center">
        <p class="section-label mb-3 text-[var(--color-accent-dark)]">POUR NOUS REJOINDRE</p>
        <h2 class="text-3xl text-[var(--color-primary)] md:text-4xl">Le tarif</h2>
        <div class="divider mx-auto mt-4 mb-6" style="background-color: var(--color-accent-dark);"></div>

        <p class="mx-auto mb-14 max-w-3xl text-balance text-base leading-relaxed text-[var(--color-text-medium)] md:text-xl">
          Session du <strong class="font-bold text-[var(--color-primary)]">15 février au 15 mai 2027</strong> : 3 mois d'accompagnement avec 2 stages en présentiel.
        </p>

        <div class="mx-auto grid max-w-2xl gap-5 md:grid-cols-2 md:gap-5">
          <div class="relative flex flex-col items-center justify-center rounded-2xl border-2 border-[var(--color-accent)] bg-[var(--color-surface)] px-6 py-6 shadow-md md:py-7">
            <span class="absolute -top-3 rounded-full bg-[var(--color-accent)] px-4 py-1 text-xs font-medium uppercase tracking-[0.15em] text-[var(--color-surface)]">5 premières places</span>
            <p class="text-sm uppercase tracking-[0.18em] text-[var(--color-accent)]">Tarif early bird</p>
            <p class="mt-3 font-['Josefin_Sans',sans-serif] text-4xl text-[var(--color-accent)] md:text-5xl" style="font-weight: 300;">1&nbsp;480&nbsp;€</p>
            <p class="mt-3 text-sm text-[var(--color-text-medium)]">soit 470&nbsp;€ de moins que le tarif normal</p>
          </div>
          <div class="flex flex-col items-center justify-center rounded-2xl border-2 border-transparent bg-[var(--color-surface)]/60 px-6 py-6 md:py-7">
            <p class="text-sm uppercase tracking-[0.18em] text-[var(--color-text-light)]">Tarif normal</p>
            <p class="mt-3 font-['Josefin_Sans',sans-serif] text-4xl text-[var(--color-primary)] md:text-5xl" style="font-weight: 300;">1&nbsp;950&nbsp;€</p>
          </div>
        </div>

        <div class="mx-auto mt-8 flex max-w-5xl flex-col items-center gap-1.5 text-base text-[var(--color-text-medium)] md:flex-row md:justify-center md:gap-6">
          <p>Payable en <strong class="font-bold text-[var(--color-primary)]">1x, 3x ou 6x sans frais</strong></p>
          <span class="hidden md:inline" aria-hidden="true">·</span>
          <p>Facture sur demande si paiement par une société</p>
        </div>

        <div class="mx-auto mt-16 max-w-5xl rounded-2xl bg-[var(--color-surface)]/70 p-6 text-left md:p-10">
          <p class="mb-5 text-center text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-accent-dark)]">Ce que comprend le programme</p>
          <ul class="grid gap-x-12 gap-y-4 md:grid-cols-2">
            {tarifRecap.map((item) => (
              <li class="flex items-start gap-3 text-[15px] leading-snug text-[var(--color-text-medium)]">
                <svg class="mt-0.5 shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg>
                <span><strong class="font-bold text-[var(--color-primary)]">{item.lead}</strong> {item.text}</span>
              </li>
            ))}
          </ul>
          <p class="mt-6 border-t border-[var(--color-border)] pt-4 text-sm leading-relaxed text-[var(--color-text-light)]">
            *Dans le tarif : la privatisation des salles des stages, les enseignements et les transmissions pour les 2 stages.<br />
            Non inclus : transport, <a href="#stages-presentiel" class="underline decoration-1 underline-offset-2 transition-colors hover:text-[var(--color-accent)]">hébergement en pension complète</a> (des options seront proposées et le transport pourra être mutualisé entre participants).
          </p>
        </div>

        <p class="mx-auto mt-14 mb-7 max-w-xl text-base leading-relaxed text-[var(--color-text-medium)] md:text-lg">
          Les inscriptions sont ouvertes. Une question avant de te lancer ? Prends un appel avec Claire.
        </p>
        <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href={registrationUrl} target="_blank" rel="noopener noreferrer" class="btn-accent">Je m'inscris</a>
          <a href={calendarUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">{t("ei.cta.secondary")}</a>
        </div>
      </div>
    </section>

    <!-- Bannière photo fine, pleine largeur (coucher de soleil) -->
    <picture class="block">
      <source media="(max-width: 767px)" srcset="/images/banniere-coucher-soleil-hd-mobile.webp" />
      <img src="/images/banniere-coucher-soleil-hd.webp" alt="Coucher de soleil sur une vallée, la lumière dorée sur les collines et les forêts" width="2560" height="320" loading="lazy" decoding="async" class="block aspect-[2/1] w-full rounded-none object-cover md:aspect-auto md:h-40" />
    </picture>

    <!-- ============================================
         11bis. RÉCAP DES BIENFAITS (rappel juste avant la FAQ)
         ============================================ -->
    <section class="bg-[var(--color-warm)] py-16 md:py-20">
      <div class="mx-auto max-w-6xl px-6">
        <p class="section-label mb-3 text-center text-[var(--color-accent)]">LES BIENFAITS</p>
        <h2 class="text-center text-3xl md:text-4xl">En 3 mois, tu :</h2>
        <div class="divider mx-auto mt-6 mb-10" style="background-color: var(--color-accent);"></div>
        <div class="grid gap-5 md:grid-cols-3 md:gap-6">
          {recapBenefits.map((b) => (
            <div class="rounded-lg border border-[var(--color-border)] border-t-[3px] bg-[var(--color-surface)] p-5 shadow-sm md:p-6" style={`border-top-color: ${b.color};`}>
              <h3 class="text-lg" style={`color: ${b.color};`}>{b.title}</h3>
              <ul class="mt-4 space-y-3">
                {b.items.map((item) => (
                  <li class="flex items-start gap-2.5 text-[15px] leading-relaxed text-[var(--color-text-medium)]">
                    <span class="mt-[5px] flex h-3.5 w-3.5 shrink-0 items-center justify-center rounded-full text-[8px] text-white" style={`background-color: ${b.color};`}>✓</span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="mx-auto mt-10 max-w-2xl text-balance text-center text-lg leading-relaxed text-[var(--color-text-medium)] md:text-xl">Une énergie que tu mets au service de tes projets, de ton bien-être et de ta vie.</p>
      </div>
    </section>

    <!-- ============================================
         12. FAQ
         ============================================ -->
    <section class="bg-[var(--color-background)] py-20 font-normal md:py-28">
      <div class="mx-auto max-w-5xl px-6">
        <p class="section-label mb-4 text-center">{t("ei.faq.label")}</p>
        <h2 class="text-center text-4xl md:text-5xl">Des questions ?</h2>
        <div class="divider mx-auto mt-6 mb-12" style="background-color: var(--color-accent);"></div>
        <div class="grid gap-2.5 md:grid-cols-2 md:items-start md:gap-x-6">
          {faqColumns.map((column) => (
            <div class="space-y-2.5">
              {column.map((faq) => (
                <details class="faq-item group border border-[var(--color-border)] bg-[var(--color-background)]">
                  <summary class="flex cursor-pointer items-center justify-between px-5 py-4">
                    <h3 class="pr-4" style="font-size: 1.1rem; font-weight: 500;">{faq.q}</h3>
                    <span class="faq-icon text-lg text-[var(--color-accent)]">+</span>
                  </summary>
                  <div class="bg-[var(--color-warm)] px-5 py-4">
                    <div class="text-base text-[var(--color-text-medium)] leading-relaxed" set:html={faq.a}></div>
                  </div>
                </details>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================
         13. CTA FINAL
         ============================================ -->
    <section class="py-20 md:py-28" style="background: linear-gradient(135deg, #CE766A 0%, #8B5A7A 50%, #1A1A1A 100%);">
      <div class="mx-auto max-w-5xl px-6 text-center">
        <p class="font-['Josefin_Sans',sans-serif] text-2xl font-medium text-[var(--color-surface)] md:text-3xl md:whitespace-nowrap">
          "Quand ton niveau d'énergie change, tout s'aligne enfin."
        </p>
        <p class="mt-4 text-sm text-[var(--color-surface)]/60">Énergie Illimitée</p>
        <div class="mt-10 flex flex-col items-center gap-4">
          <a href={registrationUrl} target="_blank" rel="noopener noreferrer" class="btn-accent !bg-[var(--color-accent)] !border-[var(--color-accent)] hover:!bg-[var(--color-warm-dark)] hover:!border-[var(--color-warm-dark)] hover:!text-[var(--color-primary)]">{lang === 'fr' ? "Je m'inscris à Énergie Illimitée" : t("ei.cta")}</a>
          <a href={calendarUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary !bg-[var(--color-warm-dark)] !border-[var(--color-warm-dark)] !text-[var(--color-primary)] hover:!bg-[var(--color-primary)] hover:!border-[var(--color-primary)] hover:!text-[var(--color-surface)]">{t("ei.cta.secondary")}</a>
          <a href="mailto:hello@amawe.com" class="text-sm text-[var(--color-surface)]/70 underline decoration-1 underline-offset-4 hover:text-[var(--color-surface)]">Questions ? envoyer un email</a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
