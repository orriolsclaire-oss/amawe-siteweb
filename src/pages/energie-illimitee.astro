    num: "01",
    icon: "🌿",
  },
  {
    title: t("ei.pillar.2.title"),
    text: t("ei.pillar.2.text"),
    benefits: [t("ei.pillar.2.benefit.1"), t("ei.pillar.2.benefit.2"), t("ei.pillar.2.benefit.3")],
    num: "02",
    icon: "🤸",
  },
  {
    title: t("ei.pillar.3.title"),
    text: t("ei.pillar.3.text"),
    benefits: [t("ei.pillar.3.benefit.1"), t("ei.pillar.3.benefit.2"), t("ei.pillar.3.benefit.3")],
    num: "03",
    icon: "🧠",
  },
  {
    title: t("ei.pillar.4.title"),
    text: t("ei.pillar.4.text"),
    benefits: [t("ei.pillar.4.benefit.1"), t("ei.pillar.4.benefit.2"), t("ei.pillar.4.benefit.3")],
    num: "04",
    icon: "🎯",
  },
]

const [badgeLead, badgeDates] = t("ei.badge").split(" : ")

const formatStats = [
  { big: "3 mois", label: "du 15 février au 15 mai 2027" },
  { big: "2 stages", label: "en présentiel, en pleine nature, tout proche de Montpellier" },
  { big: "Petit groupe", label: "10 personnes minimum, 20\u00A0maximum" },
]

const formatFeatures = [
  {
    icon: "M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2zM22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z",
    title: "Bibliothèque de contenus en illimité",
    text: "3 thèmes : alimentation, mouvement, mental et émotions. Accès illimité à la plateforme de vidéos et PDF, même après les 3 mois.",
  },
  {
    icon: "M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75",
    title: "Open-coaching chaque semaine",
    text: "Chaque mardi soir, en groupe et en live : on échange, on explore ensemble, et ce que chacun·e apporte profite à tout le groupe.",
  },
  {
    icon: "M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2M12 11a4 4 0 100-8 4 4 0 000 8z",
    title: "Suivi individuel",
    text: "Des sessions avec Claire pour assurer ton suivi et tes priorités, te motiver et te guider précisément pour atteindre ce que tu souhaites.",
  },
  {
    icon: "M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0zM12 13a3 3 0 100-6 3 3 0 000 6z",
    title: "2 stages en présentiel",
    text: "En pleine nature et tout proche de Montpellier (à une trentaine de minutes), pour ancrer la transformation.",
  },
]

const formatTimeline = [
  { when: "15 février", what: "Début du programme", stage: false },
  { when: "19-21 février", what: "Stage 1, à 30 min de Montpellier", stage: true },
  { when: "6-9 mai", what: "Stage 2, à 30 min de Montpellier", stage: true },
  { when: "15 mai", what: "Fin du programme", stage: false },
]

const tarifRecap = [
  { lead: "3 mois d'accompagnement", text: "du 15 février au 15 mai 2027" },
  { lead: "Suivi individuel mensuel", text: "avec Claire" },
  { lead: "Open-coaching", text: "en live chaque mardi soir" },
  { lead: "2 stages en présentiel*", text: "19-21 février et 6-9 mai, à 30 min de Montpellier" },
  { lead: "Bibliothèque de contenus en illimité", text: "vidéos et PDF, même après les 3 mois" },
  { lead: "Un petit groupe", text: "de 10 à 20 personnes" },
  { lead: "Les bonus inclus", text: ": masterclass d'invités, groupe WhatsApp, Cercle de Suivi, réduction pour une 3ème rencontre VIP" },
]

const recapBenefits = [
  {
    title: "Restaures ta vitalité physique",
    color: "var(--color-sage)",
    items: [
      "Une énergie plus stable, en adressant la fatigue de fond",
      "Un corps plus tonique et fonctionnel",
      "Une alimentation qui te nourrit vraiment et te donne de l'énergie",
    ],
  },
  {
    title: "Clarifies ton mental",
    color: "var(--color-blush)",
    items: [
      "Moins de pression intérieure et d'auto-sabotage",
      "Plus de calme et de présence au quotidien",
      "Une meilleure connaissance de soi et de son fonctionnement",
    ],
  },
  {
    title: "Renforces ton équilibre émotionnel",
    color: "var(--color-accent)",
    items: [
      "Des émotions que tu accueilles sans te laisser submerger",
      "Une capacité à réguler ton système nerveux selon les situations",
      "Un rapport à soi plus apaisé, une satisfaction et une confiance boostée",
    ],
  },
]

const stageCards = [
  {
    n: "Stage 1",
    dates: "19-21 février 2027",
    chip: "2 jours, au début du programme",
  },
  {
    n: "Stage 2",
    dates: "6-9 mai 2027",
    chip: "4 jours, en fin de programme",
  },
]

const hameauFacts = [
  "À 30 minutes au nord de Montpellier",
  "20 hectares de nature, face à la chaîne de la Séranne, au bord de la rivière Lamalou",
  "De nombreux espaces extérieurs pour profiter de la vue et s'immerger dans ce havre de paix et de nature, avec une piscine de 25 m",
  "Une grande salle de pratique dédiée, des hébergements variés au choix (chambres partagées ou individuelles, chalets, cabanes)",
  "Une cuisine saine de produits frais et de saison",
]

const bonuses = [
  { text: t("ei.bonus.1"), badge: "Offert" },
  { text: t("ei.bonus.4"), badge: "Offert" },
  { text: t("ei.bonus.5"), badge: "Offert" },
  { text: t("ei.bonus.6"), badge: "VIP" },
]

// Questions ajoutées à la FAQ (version FR uniquement)
const faqLevel = {
  q: "Faut-il être sportif·ve ou en forme pour suivre ce programme ?",
  a: `<p>Non, pas du tout. Le programme s'adresse à tous les niveaux. C'est tout le point d'Énergie Illimitée : retrouver la forme et l'énergie, quel que soit ton point de départ.</p><p class="mt-3">Il faut bien commencer quelque part. Le meilleur moment était hier, le deuxième, c'est aujourd'hui.</p>`,
}
const faqMedical = {
  q: "Ce programme remplace-t-il un suivi médical ?",
  a: `<p>Non. Ce programme ne remplace pas un suivi médical : il se base sur la complémentarité de la naturopathie et d'autres techniques de bien-être et de vitalité corps-esprit, dans une démarche naturelle, préventive et restaurative.</p>`,
}
const faqAfter = {
  q: "Que se passe-t-il après les 3 mois ?",
  a: `<p>Le programme ne s'arrête pas net :</p><ul class="my-2 ml-5 list-disc space-y-1.5"><li>Tu gardes l'accès à la bibliothèque de contenus (vidéos et PDF), même après les 3 mois.</li><li>Tu repars avec le groupe WhatsApp et des liens forts tissés avec les autres participants, parfois même des amitiés.</li><li>Un mois après la fin, la session « Cercle de Suivi » te permet de refaire le point.</li><li>Environ 6 mois à 1 an après la fin du programme, je te proposerai de rejoindre à tarif préférentiel une 3ème rencontre en présentiel, avec les participants de ton édition et les anciens d'Énergie Illimitée.</li></ul>`,
}
const faqPayment = {
  q: "Puis-je payer en plusieurs fois ?",
  a: `<p>Oui, tu peux régler en 1x, 3x ou 6x sans frais. Une facture est possible sur demande si tu paies avec une société.</p><p class="mt-3">Le tarif early bird (1 480 €) est réservé aux 5 premières places. Ensuite, c'est le tarif normal (1 950 €).</p><p class="mt-3">Si le prix est un frein pour toi, écris-moi par mail à <a href="mailto:hello@amawe.com" class="underline decoration-1 underline-offset-2">hello@amawe.com</a> : on en discute, j'étudie chaque situation individuellement.</p>`,
}

const faqCancel = {
  q: "Quelles sont les conditions d'annulation ?",
  a: `<p>Tu disposes du <strong>délai légal de rétractation de 14 jours</strong> à partir de ton inscription.</p><p class="mt-3">Passé ce délai, aucune annulation ni aucun remboursement n'est possible (sauf cas de force majeure justifié) : le montant total est dû et, si tu as choisi de payer en plusieurs fois, chaque paiement commencé va jusqu'au bout.</p><p class="mt-3">Tu t'engages pour un parcours de 3 mois. Si tu ne peux pas être présent·e à un open-coaching, tu retrouves le replay et tu gardes le fil. Si tu ne peux pas venir à un stage, par choix ou par empêchement, il ne peut être ni remboursé ni décalé à un autre moment : les stages sont inclus dans le programme.</p>`,
}

const faqs = [
  { q: t("ei.faq.1.q"), a: t("ei.faq.1.a") },
  faqLevel,
  { q: t("ei.faq.6.q"), a: t("ei.faq.6.a") },
  { q: t("ei.faq.3.q"), a: t("ei.faq.3.a") },
  { q: t("ei.faq.2.q"), a: t("ei.faq.2.a") },
  { q: t("ei.faq.4.q"), a: t("ei.faq.4.a") },
  { q: t("ei.faq.5.q"), a: t("ei.faq.5.a") },
  faqAfter,
  faqPayment,
  faqCancel,
  faqMedical,
]

const faqHalf = Math.ceil(faqs.length / 2)
const faqColumns = [faqs.slice(0, faqHalf), faqs.slice(faqHalf)]
---

<Layout
  title={lang === "fr" ? "Énergie Illimitée : retrouve ton énergie en 3 mois — Amawe" : `${t("ei.title")} — Amawe`}
  description={lang === "fr" ? "Programme de 3 mois pour retrouver une énergie stable et ta vitalité : coaching en groupe, suivi individuel, stages en nature, naturopathie et mouvement." : t("ei.hero.subtitle")}
  ogImage="/images/og-energie-illimitee.jpg"
>
  <Header hideBannerOnScroll />
  <main class="pt-20 font-normal [--color-text-medium:#5A4A42] [--color-text-light:#7A645A]">

    <!-- ============================================
         1. HERO — 2 colonnes : texte + photo Claire
         ============================================ -->
    <section class="relative min-h-[85vh] flex items-center overflow-hidden" style="background: linear-gradient(135deg, #CE766A 0%, #8B5A7A 50%, #1A1A1A 100%);">
      <div class="relative z-10 mx-auto max-w-7xl px-6 py-24 md:py-32">

        <!-- Titre chapeau -->
        <h1 class="text-center font-['Josefin_Sans',sans-serif] tracking-tight uppercase text-6xl text-[var(--color-surface)] md:text-8xl lg:text-9xl leading-[0.9] drop-shadow-[0_4px_24px_rgba(0,0,0,0.25)]" style="font-weight: 250;">{t("ei.title")}</h1>

        <!-- Dates de la prochaine session -->
        <p class="mt-8 text-center md:mt-10">
          <span class="inline-block rounded-full bg-[var(--color-surface)]/95 px-5 py-2.5 text-[13px] font-medium uppercase tracking-[0.1em] text-[var(--color-accent-dark)] shadow-lg md:px-6 md:text-base md:tracking-[0.18em]">
            <span class="block md:inline">{badgeLead} :</span>
            <span class="whitespace-nowrap">{badgeDates}</span>
          </span>
        </p>

        <div class="mt-10 grid items-start gap-8 md:mt-14 md:grid-cols-2 md:gap-12 lg:gap-16">

        <!-- Colonne gauche : texte -->
        <div class="order-2 md:order-1">

          <!-- Texte descriptif -->
          <p class="max-w-xl text-lg font-semibold text-[var(--color-surface)] leading-relaxed md:text-xl">
            En 3 mois, tu :
          </p>
          <ul class="mt-3 max-w-xl space-y-2.5">
            <li class="flex items-start gap-3">
              <span class="mt-[0.65em] h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-warm-dark)]"></span>
              <span class="text-lg leading-relaxed text-[var(--color-surface)] md:text-xl"><strong class="font-semibold">restaures ta vitalité physique</strong></span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-[0.65em] h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-warm-dark)]"></span>
              <span class="text-lg leading-relaxed text-[var(--color-surface)] md:text-xl"><strong class="font-semibold">clarifies ton mental</strong></span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-[0.65em] h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-warm-dark)]"></span>
              <span class="text-lg leading-relaxed text-[var(--color-surface)] md:text-xl"><strong class="font-semibold">renforces ton équilibre émotionnel</strong></span>
            </li>
          </ul>
          <p class="mt-5 max-w-xl text-lg text-[var(--color-surface)]/80 leading-relaxed md:text-xl">
            Pour arrêter de t'épuiser, retrouver un élan solide, et mettre cette énergie au service de la vie que tu veux vraiment construire.
          </p>

          <!-- Punchline -->
          <div class="mt-8 border-l-4 border-[var(--color-accent)] pl-6">
            <p class="font-['Josefin_Sans',sans-serif] text-lg text-[var(--color-accent-light)] md:text-xl">
              {t("ei.hero.punchline")}
            </p>
          </div>

          <!-- CTA -->
          <div class="mt-10 flex flex-col items-center gap-3">
            <a href={registrationUrl} target="_blank" rel="noopener noreferrer" class="btn-accent text-center leading-tight !bg-[var(--color-accent)] !border-[var(--color-accent)] hover:!bg-[var(--color-accent-light)] hover:!border-[var(--color-accent-light)] hover:!text-[var(--color-primary)]" set:html={lang === 'fr' ? "Je m'inscris<br/>à Énergie Illimitée" : t("ei.cta")}></a>
            <p class="text-sm text-center text-[var(--color-surface)]/50">{t("ei.cta.note")}</p>
            <div class="mt-2 flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
              <a href={calendarUrl} target="_blank" rel="noopener noreferrer" class="inline-block rounded-full border border-[var(--color-surface)]/70 px-6 py-3 text-xs uppercase tracking-[0.15em] text-[var(--color-surface)] transition-colors hover:bg-[var(--color-surface)] hover:text-[var(--color-accent-dark)]">{t("ei.cta.secondary")}</a>
            </div>
          </div>

          <!-- Social Proof -->
          <div class="mt-10 flex flex-wrap items-center gap-6 border-t border-[var(--color-surface)]/10 pt-6 md:gap-8">
            <div>
              <p class="font-['Josefin_Sans',sans-serif] text-2xl text-[var(--color-accent-light)] md:text-3xl">9,6<span class="text-base text-[var(--color-accent-light)]/60 md:text-lg">/10</span></p>
              <p class="text-[10px] text-[var(--color-surface)]/50 uppercase tracking-wider">satisfaction participants</p>
            </div>
            <div class="h-6 w-px bg-[var(--color-surface)]/15 hidden sm:block"></div>
            <div>
              <p class="font-['Josefin_Sans',sans-serif] text-2xl text-[var(--color-accent-light)] md:text-3xl">3 mois</p>
              <p class="text-[10px] text-[var(--color-surface)]/50 uppercase tracking-wider">d'accompagnement</p>
            </div>
            <div class="h-6 w-px bg-[var(--color-surface)]/15 hidden sm:block"></div>
            <div>
              <p class="font-['Josefin_Sans',sans-serif] text-2xl text-[var(--color-accent-light)] md:text-3xl">2</p>
              <p class="text-[10px] text-[var(--color-surface)]/50 uppercase tracking-wider">stages en présentiel</p>
            </div>
          </div>
        </div>

        <!-- Colonne droite : photo (vidéo à remettre plus tard) -->
        <div class="order-1 flex items-center md:order-2">
          <div class="relative w-full overflow-hidden rounded-lg shadow-2xl" style="aspect-ratio: 4/3;">
            <img
              src="/images/claire-ei-hero-coaching.webp"
              alt="Claire Orriols en animation — Programme Énergie Illimitée, transmission en présentiel"
              width="1600"
              height="1200"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              class="absolute inset-0 h-full w-full object-cover"
            />
          </div>
        </div>
        </div>
      </div>

      <!-- Ligne d'accent en bas du hero -->
      <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-[var(--color-accent)] via-[var(--color-accent)]/50 to-transparent"></div>
    </section>

    <!-- ============================================
         3. PROMESSE — Texte + photo portrait
         ============================================ -->
    <section class="py-20 md:py-28">
      <div class="mx-auto max-w-6xl px-6">
        <!-- Titre chapeau -->
        <p class="section-label mb-3 text-center text-[var(--color-accent)] tracking-[0.25em]">{lang === 'fr' ? "L'INTENTION" : 'THE INTENTION'}</p>
        <h2 class="text-center text-4xl md:text-5xl" set:html={t("ei.promise.title")}></h2>

        <div class="mt-14 grid items-center gap-12 md:mt-16 md:grid-cols-2 md:gap-20">
        <!-- Photo portrait (mobile : en premier) -->
        <div class="order-1 md:order-2">
          <img
            src="/images/claire-energie-illimitee.webp"
            alt="Claire Orriols — Programme Énergie Illimitée, accompagnement en santé holistique"
            width="683"
            height="1024"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="mx-auto aspect-[3/4] w-full max-w-md object-cover shadow-lg"
          />
        </div>
        <!-- Texte promesse -->
        <div class="order-2 md:order-1">
          <div class="divider"></div>
          <p class="mt-8 text-lg leading-relaxed text-[var(--color-text-medium)]">
            {t("ei.promise.intro")}
          </p>
          <p class="mt-6 text-xl font-semibold text-[var(--color-primary)]">Pendant 3 mois, tu es accompagné·e pour :</p>
          <div class="mt-8 space-y-5">
            <div class="flex items-start gap-4 py-3">
              <span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-sage)] text-xs text-white">✓</span>
              <p class="text-[var(--color-text-medium)]"><strong class="font-semibold text-[var(--color-accent)]">Restaurer</strong> {t("ei.promise.1")}</p>
            </div>
            <div class="flex items-start gap-4 py-3">
              <span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-sage)] text-xs text-white">✓</span>
              <p class="text-[var(--color-text-medium)]"><strong class="font-semibold text-[var(--color-accent)]">Clarifier</strong> {t("ei.promise.2")}</p>
            </div>
            <div class="flex items-start gap-4 py-3">
              <span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-sage)] text-xs text-white">✓</span>
              <p class="text-[var(--color-text-medium)]"><strong class="font-semibold text-[var(--color-accent)]">Construire</strong> {t("ei.promise.3")}</p>
            </div>
          </div>
          <div class="mt-10 rounded-lg border border-[var(--color-border)] bg-[var(--color-warm)] p-6 sm:p-7">
            <p class="mb-4 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--color-accent)]">{lang === 'fr' ? 'Ce que ça inclut' : 'What\'s included'}</p>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <span class="mt-[0.55em] h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-accent)]"></span>
                <span class="text-base text-[var(--color-text-medium)]"><strong class="font-bold text-[var(--color-primary)]">{lang === 'fr' ? 'Coaching et mentorat' : 'Coaching and mentoring'}</strong> {lang === 'fr' ? 'chaque semaine' : 'every week'}</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-[0.55em] h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-accent)]"></span>
                <span class="text-base text-[var(--color-text-medium)]"><strong class="font-bold text-[var(--color-primary)]">{lang === 'fr' ? 'Bibliothèque de contenus' : 'Content library'}</strong> {lang === 'fr' ? 'vidéos et PDF en illimité' : 'to move at your own pace'}</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-[0.55em] h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-accent)]"></span>
                <span class="text-base text-[var(--color-text-medium)]"><strong class="font-bold text-[var(--color-primary)]">{lang === 'fr' ? 'Suivi individuel' : 'Individual follow-up'}</strong> {lang === 'fr' ? 'mensuel' : 'monthly'}</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-[0.55em] h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-accent)]"></span>
                <span class="text-base text-[var(--color-text-medium)]"><strong class="font-bold text-[var(--color-primary)]">{lang === 'fr' ? '2 stages en présentiel' : 'In-person retreats'}</strong></span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-[0.55em] h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-accent)]"></span>
                <span class="text-base text-[var(--color-text-medium)]"><strong class="font-bold text-[var(--color-primary)]">{lang === 'fr' ? 'Un groupe qui te soutient' : 'A supportive group'}</strong></span>
              </li>
            </ul>
          </div>
