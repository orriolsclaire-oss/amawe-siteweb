const calendarUrl = "https://calendar.app.google/FHzZyGNn5zqd1ZJq9"
// À remplacer par le lien des inscriptions (en attendant, même formulaire que la liste d'attente)
const registrationUrl = waitlistUrl
const videoUrl = "https://www.youtube.com/embed/8rZzKqrOTsQ"

const resultBlocks = [
  {
    title: t("ei.results.body.title"),
    icon: "🌿",
