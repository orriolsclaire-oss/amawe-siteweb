---
import Layout from "~/layouts/Layout.astro"
import Header from "~/components/Header.astro"
import Footer from "~/components/Footer.astro"

// TODO — remplacer par l'URL Podia réelle du produit Flow dès qu'elle est active.
const checkoutUrl = "https://mesprogrammes.amawe.com/flow"
const contactEmail = "hello@amawe.com"
const promoEndDate = "2026-10-25"

// 5 familles de mouvement — ordre et noms tranchés
const families = [
  { title: "Respirer", text: "Travail du souffle en mouvement ou statique, pour réguler le système nerveux, oxygéner les tissus et s'ancrer dans le présent." },
  { title: "Libérer", text: "Mobilité douce, étirements actifs, décharge des tensions corporelles, émotionnelles et mentales." },
  { title: "Bouger librement", text: "Mouvement naturel et exploration, pour redécouvrir tout ce que ton corps sait faire, dehors ou chez toi." },
  { title: "Renforcer", text: "De la force fonctionnelle, au poids du corps ou avec des poids légers, pour un corps solide, tonique et durablement en forme." },
  { title: "Relaxer", text: "Détente profonde, retour au calme, intégration et appréciation des pratiques proposées." },
]

// Pour qui — 8 profils, chacun résumé par un mot + un picto SVG
const forYou = [
  { tag: "Élan retrouvé", icon: "sparkles", text: "Tu as envie de bouger, mais pas de t'astreindre à un programme de fitness classique, avec ses objectifs, ses chronos, ses injonctions." },
  { tag: "Gestion du stress", icon: "wind", text: "Le stress s'est logé quelque part, épaules, mâchoire serrée, ventre noué, dos ou hanches bloquées, et tu veux un moyen concret de le faire sortir, pas juste d'en parler." },
  { tag: "Mobilité", icon: "activity", text: "Tu es plutôt sédentaire, et tu sens ton corps se raidir sans savoir par où commencer pour le débloquer." },
  { tag: "Liberté et confiance", icon: "sun", text: "Tu veux retrouver de la liberté dans ton corps, te sentir plus vivant·e, plus présent·e et plus confiant·e au quotidien." },
  { tag: "Énergie", icon: "zap", text: "Tu sens que ton énergie est basse, bloquée ou stagnante, et tu sais que la clé pour retrouver une meilleure vitalité passe par le corps." },
  { tag: "Reconnexion", icon: "link", text: "Tu as perdu la connexion avec ton corps (un peu, beaucoup ou complètement) et tu veux la retrouver." },
  { tag: "Ancrage", icon: "anchor", text: "Tu veux sortir du mental et revenir dans ton corps, cesser de tourner en boucle et apprécier l'instant." },
  { tag: "Plaisir et santé", icon: "heart", text: "Tu veux trouver une pratique corporelle simple, dans laquelle tu prends plaisir et qui prend soin de toi." },
]

// Paths SVG des pictos (Lucide-style, viewBox 24)
const iconPaths: Record<string, string> = {
  sparkles: "M12 3l1.5 4.5L18 9l-4.5 1.5L12 15l-1.5-4.5L6 9l4.5-1.5L12 3zM5 17l.75 2.25L8 20l-2.25.75L5 23l-.75-2.25L2 20l2.25-.75L5 17zM19 14l.75 2.25L22 17l-2.25.75L19 20l-.75-2.25L16 17l2.25-.75L19 14z",
  wind: "M9.59 4.59A2 2 0 1111 8H2m10.59 11.41A2 2 0 1014 16H2m15.73-8.27A2.5 2.5 0 1119.5 12H2",
  activity: "M5 9L2 12l3 3M9 5l3-3 3 3M15 19l-3 3-3-3M19 9l3 3-3 3M2 12h20M12 2v20",
  sun: "M12 4V2m0 20v-2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32l1.41-1.41M16 12a4 4 0 11-8 0 4 4 0 018 0z",
  zap: "M13 2L3 14h9l-1 8 10-12h-9l1-8z",
  link: "M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71m-.29 5.82a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71",
  anchor: "M12 22V8m-7 6l7-6 7 6M5 22a7 7 0 007-7v-3m0 3v3a7 7 0 007 7M12 8a3 3 0 100-6 3 3 0 000 6z",
  heart: "M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z",
}

// Ce qui est inclus — enrichi (question introspective quotidienne)
const included = [
  "15 séances de mouvement filmées (18 à 25 minutes chacune)",
  "15 audios (vision, pédagogie, pratiques concrètes)",
  "Une question d'introspection à la fin de chaque séance, pour te relier à ton ressenti",
  "Accès immédiat et illimité",
  "Un live bonus avec Claire, le 31 octobre au matin",
]

// 15 thèmes d'audio (source : intent.md, thèmes tranchés 28/09)
const themes = [
  { day: "J2", title: "Pourquoi ton corps retient tout" },
  { day: "J4", title: "Le corps n'est pas une machine à performer" },
  { day: "J6", title: "Le souffle, ton régulateur gratuit" },
  { day: "J8", title: "L'équilibre, une meilleure boussole que la performance" },
  { day: "J10", title: "Pourquoi tes hanches sont bloquées" },
  { day: "J12", title: "Marcher et courir…" },
  { day: "J14", title: "La force fonctionnelle vs la force de salle" },
  { day: "J16", title: "Ralentir pour ressentir" },
  { day: "J18", title: "Le stress, ce qui se passe vraiment dans ton corps" },
  { day: "J20", title: "Réveiller l'énergie vitale" },
  { day: "J22", title: "Le jeu, l'enfant que tu as été" },
  { day: "J24", title: "La nature comme régulateur, pas comme décor" },
  { day: "J26", title: "Porter, une compétence oubliée" },
  { day: "J28", title: "Me renforcer et bouger dans mon quotidien" },
  { day: "J30", title: "Bilan des 30 jours + plan pour la suite" },
]

// FAQ
const faqs = [
  {
    q: "Est-ce fait pour moi si je ne suis pas “sportive” ?",
    a: "Oui, complètement. Flow n'est pas un programme de performance. Tu avances à ton rythme, sans objectif à atteindre, sans pression.",
  },
  {
    q: "Combien de temps par jour ?",
    a: "Entre 15 et 25 minutes, un jour sur deux. L'autre jour, un audio de 8 à 12 minutes.",
  },
  {
    q: "De quel matériel j'ai besoin ?",
    a: "Un tapis, deux haltères de 3 kg (ou deux bouteilles d'eau), une balle de tennis, une chaise stable ou un mur. Rien d'exotique, rien à acheter de coûteux.",
  },
  {
    q: "Comment ça se passe concrètement ?",
    a: "Tout est accessible sur Podia, immédiatement après ton achat, à ton rythme, sans limite dans le temps.",
  },
  {
    q: "C'est réservé aux femmes ?",
    a: "Non, toute personne est bienvenue.",
  },
  {
    q: "J'ai un problème de dos, de genou, je suis enceinte, je peux faire Flow ?",
    a: "Écoute ton corps et adapte chaque mouvement. En cas de doute, demande l'avis de ton médecin ou de ton kiné avant de commencer.",
  },
  {
    q: "Et si j'ai une autre question ?",
    a: `Écris-nous à <a href="mailto:${contactEmail}" class="underline decoration-1 underline-offset-2">${contactEmail}</a>, on te répond.`,
  },
]

const testimonials = [
  {
    src: "/images/temoignage-flow-sandra.png",
    alt: "Témoignage de Sandra sur le programme Flow — mise en mouvement, déverrouillage du bassin, prise de conscience corporelle",
    width: 1022,
    height: 723,
  },
  {
    src: "/images/temoignage-flow-anne-michele.png",
    alt: "Témoignage sur Flow — chemin pour se reconnecter à sa puissance intérieure",
    width: 683,
    height: 450,
  },
  {
    src: "/images/temoignage-flow-anonyme-1.png",
    alt: "Témoignage sur Flow — un programme de grande qualité",
    width: 1010,
    height: 61,
  },
  {
    src: "/images/temoignage-flow-amelie.png",
    alt: "Témoignage d'Amélie sur Flow — audios courts, thématiques, remettre du mouvement dans sa vie",
    width: 1005,
    height: 370,
  },
  {
    src: "/images/temoignage-flow-sandrine.png",
    alt: "Témoignage de Sandrine sur Flow — parcours qui permet de prendre du temps pour soi et se reconnecter à son corps",
    width: 1019,
    height: 141,
  },
  {
    src: "/images/temoignage-flow-anonyme-2.png",
    alt: "Témoignage sur Flow — prendre du temps pour soi, se reconnecter à son corps et prendre du recul",
    width: 1005,
    height: 88,
  },
]

// SEO
const pageTitle = "Flow, 30 jours pour te reconnecter à ton corps | Amawé"
const pageDescription =
  "Flow, c'est 30 jours pour libérer les tensions et le stress, retrouver de la mobilité et gagner en liberté. 15 séances filmées + 15 audios, à ton rythme, en accès illimité. 88 € au lieu de 110 € jusqu'au 25 octobre."

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Flow, programme de mouvement 30 jours",
  description: pageDescription,
  brand: { "@type": "Brand", name: "Amawé" },
  offers: {
    "@type": "Offer",
    price: "88",
    priceCurrency: "EUR",
    availability: "https://schema.org/InStock",
    priceValidUntil: promoEndDate,
    url: checkoutUrl,
  },
}
---

<Layout title={pageTitle} description={pageDescription} jsonLd={jsonLd}>
  <Header hideBannerOnScroll />
  <main class="pt-20 overflow-x-hidden">
    <!-- ============================================
         1. HERO — composition asymétrique, tons clairs (Lin / Sable Doré)
         ============================================ -->
    <section
      class="relative flex min-h-[85vh] items-center overflow-hidden"
      style="background: linear-gradient(135deg, #F8F3F0 0%, #F5EFE7 45%, #E8D5B5 100%);"
    >
      <!-- Trace SVG — une seule ligne courbe pleine, dans la bande haute -->
      <svg
        class="pointer-events-none absolute inset-x-0 top-0 h-36 w-full opacity-70 md:h-52"
        viewBox="0 0 1440 200"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          d="M -50 150 Q 360 -20 720 100 T 1500 20"
          stroke="#CE766A"
          stroke-width="2"
          fill="none"
          stroke-linecap="round"
        />
      </svg>

      <div class="relative z-10 mx-auto w-full max-w-6xl px-6 py-20 md:py-24">
        <div class="grid items-center gap-10 md:grid-cols-12 md:gap-8">
          <!-- Colonne gauche : titre + promesse (asymétrique) -->
          <div class="order-2 md:order-1 md:col-span-7">
            <p class="section-label mb-6 !text-[var(--color-primary)]">Amawé · Programme mouvement</p>

            <!-- Titre géant qui déborde sur la droite (asymétrie) -->
            <h1
              class="font-['Josefin_Sans',sans-serif] uppercase leading-[0.85] tracking-[-0.02em] text-7xl text-[var(--color-primary)] md:text-[9.5rem] lg:text-[12rem]"
              style="font-weight: 250; margin-left: -0.05em;"
            >
              Flow
            </h1>

            <p
              class="mt-6 max-w-xl font-['Josefin_Sans',sans-serif] text-2xl italic leading-tight text-[var(--color-accent)] md:text-3xl"
            >
              30 jours pour te reconnecter à ton corps.
            </p>

            <!-- Le "c'est quoi" en une phrase — pose le format d'entrée -->
            <p class="mt-6 max-w-xl text-base leading-relaxed text-[var(--color-text-medium)] md:text-lg">
              Un <strong class="font-medium text-[var(--color-primary)]">programme de 30 jours</strong> avec Claire, où chaque jour, tu es guidé·e dans une <strong class="font-medium text-[var(--color-primary)]">exploration corporelle unique</strong> par des séances en vidéos et des audios.
            </p>

            <!-- Triptyque promesse — aligné, avec tirets -->
            <div class="mt-8 flex flex-col gap-1.5">
              <p class="text-lg leading-snug text-[var(--color-primary)] md:text-xl">
                <span class="mr-3 text-[var(--color-accent)]">—</span>
                Libérer les tensions et le stress.
              </p>
              <p class="text-lg leading-snug text-[var(--color-primary)] md:text-xl">
                <span class="mr-3 text-[var(--color-accent)]">—</span>
                Retrouver de la mobilité.
              </p>
              <p class="text-lg leading-snug text-[var(--color-primary)] md:text-xl">
                <span class="mr-3 text-[var(--color-accent)]">—</span>
                Gagner en liberté.
              </p>
            </div>

            <!-- CTA -->
            <div class="mt-10 flex flex-col items-start gap-3">
              <a
                href={checkoutUrl}
                class="btn-accent leading-tight !bg-[var(--color-accent)] !border-[var(--color-accent)] !px-9 !py-3.5 hover:!bg-[var(--color-accent-dark)] hover:!border-[var(--color-accent-dark)] md:!px-10 md:!py-4 md:!text-sm"
              >
                Je commence Flow · 88&nbsp;€ <span class="ml-1.5 opacity-70 line-through">110&nbsp;€</span>
              </a>
              <p class="text-sm text-[var(--color-text-medium)]">
                En promo jusqu'au 25 octobre &nbsp;·&nbsp; Accès immédiat et illimité
              </p>
            </div>
          </div>

          <!-- Colonne droite : photo inclinée -->
          <div class="order-1 md:order-2 md:col-span-5">
            <div
              class="relative w-full overflow-hidden rounded-lg shadow-2xl"
              style="aspect-ratio: 3/4; transform: rotate(-2deg);"
            >
              <img
                src="/images/claire-danse-libre.webp"
                alt="Claire Orriols en mouvement libre, programme Flow, mouvement pour se reconnecter au corps"
                width="1200"
                height="1600"
                loading="eager"
                decoding="async"
                fetchpriority="high"
                class="absolute inset-0 h-full w-full object-cover"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Ligne d'accent bas -->
      <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-[var(--color-accent)] via-[var(--color-accent)]/50 to-transparent"></div>
    </section>

    <!-- ============================================
         2. SOUS-PROMESSE — L'intention
         ============================================ -->
    <section class="pt-16 pb-16 md:pt-24 md:pb-24">
      <div class="mx-auto max-w-6xl px-6 text-center">
        <h2 class="text-4xl !text-[var(--color-primary)] md:text-5xl">
          Et si tu te (re)mettais à bouger…<br /><em
            class="font-['Josefin_Sans',sans-serif] font-light italic text-[var(--color-accent)]"
          >mais autrement ?</em>
        </h2>
        <div class="divider mx-auto mt-6 mb-8" style="background-color: var(--color-sage-dark);"></div>

        <div class="space-y-3 text-lg leading-relaxed text-[var(--color-primary)] md:text-xl">
          <p>
            Pas pour transpirer à tout prix. Pas pour brûler des calories. Pas par force ou contrainte.
          </p>
          <p>
            Mais pour <strong class="font-semibold">te sentir vivant·e</strong>. Pour écouter ton corps. Pour réveiller ton énergie là où elle sommeille. Pour <strong class="font-semibold">retrouver confiance</strong>.
          </p>
          <p>
            Pour retrouver un corps qui bouge parce que <strong class="font-semibold">ça lui fait du bien</strong>.
          </p>
          <p>
            Flow est un programme à la fois <strong class="font-semibold">doux et puissant</strong> (et dans tous les cas <em>transformateur</em>), pour revenir dans ton corps, à ton rythme, par le mouvement. <strong class="font-semibold">Accessible à tous niveaux.</strong>
          </p>
        </div>
      </div>
    </section>

    <!-- ============================================
         3. FLOW, C'EST QUOI — vue d'ensemble de l'expérience quotidienne
         ============================================ -->
    <section class="relative overflow-hidden bg-[var(--color-primary)] py-20 md:py-28">
      <!-- Mot décoratif "Flow" en background — juste le haut caché derrière les placeholders -->
      <p
        class="pointer-events-none absolute bottom-2 -right-4 font-['Josefin_Sans',sans-serif] uppercase text-[10rem] leading-none text-[var(--color-surface)]/[0.04] md:bottom-4 md:text-[15rem]"
        style="font-weight: 200;"
        aria-hidden="true"
      >
        Flow
      </p>

      <div class="relative mx-auto max-w-6xl px-6">
        <div class="grid gap-14 md:grid-cols-12 md:gap-16">
          <!-- Colonne gauche : titre + "30 jours" XXL -->
          <div class="md:col-span-5">
            <p class="section-label mb-3 !text-[var(--color-accent-light)] tracking-[0.25em]">
              FLOW, C'EST QUOI ?
            </p>
            <h2
              class="text-4xl !text-[var(--color-surface)] md:text-5xl lg:text-6xl"
              style="color: var(--color-surface); font-weight: 250;"
            >
              Ce que tu vis pendant
            </h2>
            <p
              class="mt-2 font-['Josefin_Sans',sans-serif] text-7xl leading-none text-[var(--color-accent)] md:text-8xl lg:text-9xl"
              style="font-weight: 200; letter-spacing: -0.02em;"
            >
              30 jours
            </p>
            <div class="mt-6 h-px w-16 bg-[var(--color-accent)]"></div>
          </div>

          <!-- Colonne droite : ce que tu as chaque jour -->
          <div class="md:col-span-7">
            <p
              class="mb-6 font-['Josefin_Sans',sans-serif] text-xl text-[var(--color-warm-dark)] md:text-2xl"
              style="font-weight: 300;"
            >
              Chaque jour, tu as accès à :
            </p>
            <ul class="space-y-4">
              <li class="flex items-start gap-4">
                <span
                  class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-sage)] text-xs text-white"
                >
                  ✓
                </span>
                <p class="text-base leading-relaxed text-[var(--color-surface)] md:text-lg">
                  Une <strong class="font-semibold text-[var(--color-warm-dark)]">séance filmée</strong> de 18 à 25 minutes (un jour sur deux)
                </p>
              </li>
              <li class="flex items-start gap-4">
                <span
                  class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-sage)] text-xs text-white"
                >
                  ✓
                </span>
                <p class="text-base leading-relaxed text-[var(--color-surface)] md:text-lg">
                  Un <strong class="font-semibold text-[var(--color-warm-dark)]">audio de réflexions</strong> de 5 à 12 minutes (un jour sur deux)
                </p>
              </li>
              <li class="flex items-start gap-4">
                <span
                  class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-sage)] text-xs text-white"
                >
                  ✓
                </span>
                <p class="text-base leading-relaxed text-[var(--color-surface)] md:text-lg">
                  Des <strong class="font-semibold text-[var(--color-warm-dark)]">thèmes d'exploration</strong> (libération, respiration, force, ancrage, équilibre…)
                </p>
              </li>
              <li class="flex items-start gap-4">
                <span
                  class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-sage)] text-xs text-white"
                >
                  ✓
                </span>
                <p class="text-base leading-relaxed text-[var(--color-surface)] md:text-lg">
                  Une <strong class="font-semibold text-[var(--color-warm-dark)]">exploration de différentes formes de mouvement</strong> (mouvement naturel, yoga, renforcement et mobilité…)
                </p>
              </li>
              <li class="flex items-start gap-4">
                <span
                  class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-sage)] text-xs text-white"
                >
                  ✓
                </span>
                <p class="text-base leading-relaxed text-[var(--color-surface)] md:text-lg">
                  Des <strong class="font-semibold text-[var(--color-warm-dark)]">questions d'introspection</strong> pour te relier à ton ressenti
                </p>
              </li>
            </ul>
          </div>
        </div>

        <!-- Placeholders vidéos / audios / photos — aperçu compact du contenu -->
        <div class="mt-14 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-5 md:gap-4">
          <!-- Placeholder 1 : vidéo -->
          <div class="relative aspect-video overflow-hidden rounded-lg shadow-xl">
            <img
              src="/images/claire-danse-libre.webp"
              alt="Aperçu séance vidéo Flow"
              width="600"
              height="400"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover"
            />
            <div class="absolute inset-0 flex items-center justify-center bg-black/30">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-[var(--color-surface)]/95 shadow-md">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="var(--color-primary)" aria-hidden="true">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>
            </div>
          </div>

          <!-- Placeholder 2 : audio -->
          <div class="flex flex-col justify-center rounded-lg border border-[var(--color-surface)]/15 bg-[var(--color-surface)]/[0.06] p-3 backdrop-blur-sm">
            <div class="flex items-center gap-2">
              <button
                type="button"
                aria-label="Extrait audio"
                class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[var(--color-accent)] text-[var(--color-surface)]"
              >
                <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </button>
              <div class="flex-1 min-w-0">
                <p class="text-[10px] font-medium text-[var(--color-surface)] truncate">
                  <span class="text-[var(--color-warm-dark)]">J6</span> · Le souffle
                </p>
                <div class="mt-1 flex items-center gap-1">
                  <div class="flex-1 h-[3px] overflow-hidden rounded-full bg-[var(--color-surface)]/20">
                    <div class="h-full w-[35%] rounded-full bg-[var(--color-accent)]"></div>
                  </div>
                  <span class="text-[8px] tabular-nums text-[var(--color-surface)]/60">08:12</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Placeholder 3 : vidéo -->
          <div class="relative aspect-video overflow-hidden rounded-lg shadow-xl">
            <img
              src="/images/claire-orriols-meditation-yoga-aveyron-energie-illimitee.webp"
              alt="Aperçu séance yoga Flow"
              width="600"
              height="400"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover"
            />
            <div class="absolute inset-0 flex items-center justify-center bg-black/30">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-[var(--color-surface)]/95 shadow-md">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="var(--color-primary)" aria-hidden="true">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>
            </div>
